# ============================================
#  此文件仅供参考，列出所有可用的环境变量。
#  .env 文件由系统自动创建和管理，
#  所有配置通过 Settings 网页修改即可。
# ============================================

# ── LLM（Settings > LLM API）──
LLM_PROVIDER=deepseek
LLM_API_KEY=
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-v4-flash

# ── 基础设施 ──
PORT=3099
DB_PATH=./data/agent.db
VECTOR_SERVICE_URL=http://localhost:8765
COMFYUI_URL=http://localhost:8188
COMFYUI_OUTPUT_DIR=./output

# ── SthStart 公共服务（逐模块迁移；失败时保留原路径回退）──
STHSTART_SERVICE_URL=http://127.0.0.1:4100
STHSTART_APP_TOKEN=
STHSTART_LLM_PROFILE=
STHSTART_VECTOR_PROFILE=
STHSTART_IMAGE_PROFILE=
STHSTART_PUBLIC_LLM=false
STHSTART_PUBLIC_VECTOR=false
STHSTART_PUBLIC_IMAGE=false

# ── 天气 ──
WEATHER_CITY=
